  "confirmed_game_defects_fixed": 2,
  "diagnoses": [
    {
      "kind": "confirmed_game_defect",
      "subject": "Native form display-name checkpoints",
      "cause": "SpeciesName is a str subclass. Evennia stored it as an iterable SaverList, corrupting restored Ogerpon/Terapagos display names and causing a waiting-message TypeError.",
      "fix": "Store top-level names and nested string subclasses as plain text before saving Attributes.",
      "proof": "Fresh live reproduction, failing disposable PostgreSQL regression, all four Ogerpon forms and Terapagos pass repeat rebuilds; live Hearthflame also passes a real reload."
    },
    {
      "kind": "confirmed_game_defect",
      "subject": "Weather and terrain after restore",
      "cause": "The checkpoint retained field identifiers and durations but omitted runtime handlers; restored counters stopped advancing.",
      "fix": "Reconnect handlers and the weather-state alias without replaying field Start hooks or resetting timers.",
      "proof": "Fresh live and PostgreSQL reproductions; sun/rain/electric/grassy expiry including eight-turn item extensions; live sun/electric expiry through real reload."
    },
    {
      "kind": "fixture_repair",
      "subject": "Two PostgreSQL cleanup errors",
      "cause": "Transport-only room/player wrappers had id but lacked pk, which native post-battle item cleanup now uses.",
      "fix": "Expose real database primary keys on those integration fixtures; no cleanup or reward code weakened."
    },
    {
      "kind": "runner_or_fixture_diagnoses",
      "subject": "Observation and orchestration false flags",
      "details": [
        "Detach nested Evennia saver mappings to JSON instead of repr text.",
        "Normalize persisted lowercase inventory item identifiers when counting resources.",
        "Read field duration from the actual pseudo-weather entry.",
        "Persist the test nickname before expecting the owned-model nickname after restore.",
        "Compare public metadata only across a quiet disposable-suite run; intentional concurrent live QA legitimately advances battle IDs.",
        "Keep pytest temporary fixtures outside the artifact folder to preserve the manifest-boundary test precondition. Focused safety tests and the full suite were rerun."
      ]
    }
  ],
