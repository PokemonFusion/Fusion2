    "source": "\"\"\"Supplement UI proof with a real two-controller turn, refusing every DB.\"\"\"\n\nimport os\nfrom pathlib import Path\nimport sys\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\nROOT = Path(r\"H:\\PokemonFusionProject\\fusion2\")\nsys.path[:0] = [str(ROOT), str(ROOT / \"tests/helpers\")]\nos.environ.setdefault(\"DJANGO_SETTINGS_MODULE\", \"server.conf.settings\")\n\nimport compact_battle_player_flow as ui\nfrom django.db.backends.base.base import BaseDatabaseWrapper\n\nwith patch.object(BaseDatabaseWrapper, \"ensure_connection\", ui.refuse_database):\n    import django\n\n    django.setup()\n    import evennia\n    from evennia.commands.command import Command\n    from evennia.commands.cmdset import CmdSet\n\n    evennia.Command, evennia.CmdSet = Command, CmdSet\n    from commands.player.cmd_battle_attack import CmdBattleAttack\n    from commands.player.cmd_showbattle import CmdShowBattle\n    from utils.battle_display import strip_ansi\n\n    session, players = ui.fixture()\n    session.room = NS(ndb=NS(), db=NS())\n    session.notify = session.msg\n    session.battle.log_action = session.msg\n    own, foe = session.battle.participants[0].active[0], session.battle.participants[1].active[0]\n    players[2].db.battle_ui_style = \"pf1\"\n    with patch(\"commands.player.cmd_battle_attack.get_system\", return_value=NS(battle_manager=None)):\n        for player in [players[0], players[2]]:\n            command = CmdBattleAttack()\n            command.caller, command.args, command.switches = player, \"Double Team\", []\n            command.parse()\n            command.func()\n        assert set(session.state.declare) == {\"A1\", \"B1\"}, session.state.declare\n        session.run_turn()\n        assert not session.turn_state.get(\"error\"), session.turn_state\n        assert own.boosts.get(\"evasion\") == 1 and foe.boosts.get(\"evasion\") == 1\n        assert own.moves[3].pp == foe.moves[3].pp == 6\n        compact = strip_ansi(\"\\n\".join(players[0].messages))\n        classic = strip_ansi(\"\\n\".join(players[2].messages))\n        assert \"LAST TURN\" in compact and \"Double Team\" in compact\n        assert \"LAST TURN\" not in classic and \"Double Team\" in classic\n        assert \"Evasion +1\" in compact\n        assert not session.state.declare\n    print(\"Real native Double Team turn passed through +attack, engine and BattleSession.run_turn; PP 7->6 and Evasion +1 for both; grouped compact and preserved PF1 stream; no database/socket.\")\n",
    "log": "Real native Double Team turn passed through +attack, engine and BattleSession.run_turn; PP 7->6 and Evasion +1 for both; grouped compact and preserved PF1 stream; no database/socket.\n",
    "limit": "Synthetic captured messaging; real +attack, engine resolution and BattleSession.run_turn; no SQL/socket"
  },
